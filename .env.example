# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
APP_URL="MY_APP_URL"

# =====================================================================
# DISCORD BOT SECRET CONFIGURATION
# =====================================================================
# Place your Discord bot token here or in your hosting environment secrets.
# Both DISCORD_BOT_TOKEN and MASTER_BOT_TOKEN are supported aliases.
# This file (.env) is git-ignored and never committed to source control.
DISCORD_BOT_TOKEN="your_discord_bot_token_here"
MASTER_BOT_TOKEN="your_discord_bot_token_here"

# Primary Discord Guild ID (Target Server)
GUILD_ID="1562129145788375090"

# NOPE_CAPTCHA_KEY: Your NopeCaptcha API Key for automated hCaptcha solving
NOPE_CAPTCHA_KEY="q4gd0knx5mzt60oe"

# PREFIX: The command prefix for the master bot (Default: !)
PREFIX="!"

# OWNER_IDS: Comma-separated list of Discord user IDs allowed to run master commands
OWNER_IDS="1546693679660539977,1458799796297924719,1505065613192728636,1222232115027116173,1522255932405579818"

# ACCOUNTS_JSON: Optional. A JSON array string representing your registered worker accounts
# Example: [{"alias": "worker1", "token": "TOKEN_1", "proxy": "", "status": "online"}]
ACCOUNTS_JSON=""

# =====================================================================
# GITHUB OAUTH CREDENTIALS (https://github.com/settings/developers)
# =====================================================================
# Create an OAuth App at https://github.com/settings/developers
# Development Authorization callback URL: https://ais-dev-xl6yradzy3p4lfs5k3admm-420115024230.asia-east1.run.app/auth/github/callback
# Shared Authorization callback URL: https://ais-pre-xl6yradzy3p4lfs5k3admm-420115024230.asia-east1.run.app/auth/github/callback
GITHUB_CLIENT_ID=""
GITHUB_CLIENT_SECRET=""
CLIENT_ID=""
CLIENT_SECRET=""
